# BookNest Environment Configuration Template
# Copy this file to .env and configure your local settings

# Django Security
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# MySQL Database Configuration
DB_NAME=booknest_db
DB_USER=booknest_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
